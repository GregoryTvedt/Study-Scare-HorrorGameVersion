{
    "compilerOptions": {
      "target"              : "esnext",
      "module"              : "es2022",
      "rootDir"             : "src",
      "outDir"              : "dist",
      "sourceMap"           : true,
      "extendedDiagnostics" : true
    },

    "include": [
        "src/**/*"
    ],
    "exclude": [
      "./node_modules"
    ]
}